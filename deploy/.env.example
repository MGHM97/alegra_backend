# =============================================================================
# Alegra Festas — .env da RAIZ do deploy (mesma pasta de docker-compose.yml
# e docker-compose.prod.yml — NÃO confundir com alegra_backend/.env ou
# alegra_frontend/.env.compose, que são outros arquivos).
#
# Copie para `.env` na raiz do deploy (ver deploy/DEPLOY.md, passo 3).
# =============================================================================

# Domínio público do piloto (A/AAAA apontando para o IP do VPS) ou um host
# sslip.io se ainda não tiver domínio próprio, ex.: alegra.1-2-3-4.sslip.io
# (troque 1-2-3-4 pelo IP real do servidor, com hífens no lugar dos pontos).
# Usado pelo Caddyfile (deploy/Caddyfile) para provisionar o certificado
# TLS automático e como host do reverse proxy.
SITE_DOMAIN=alegra.1-2-3-4.sslip.io

# URL pública completa (com esquema) — same-origin, então normalmente é
# https:// + SITE_DOMAIN. Usado pelo serviço `web` (nginx) para compor o
# `connect-src` da CSP. Mantenha igual a `VITE_SITE_URL` do
# alegra_frontend/.env.compose e a `PUBLIC_SITE_URL`/`CORS_ORIGIN` do
# alegra_backend/.env — as 3 variáveis devem apontar para o MESMO domínio.
API_ORIGIN=https://alegra.1-2-3-4.sslip.io
