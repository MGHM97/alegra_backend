# =============================================================================
# Alegra Festas - Backend env
# Em PRODUÇÃO (NODE_ENV=production) o boot ABORTA se detectar valores de exemplo,
# CORS localhost/http, segredos fracos ou Stripe/SMTP ausentes. Ver env.ts.
# =============================================================================

# Database
# Pool de conexões do Prisma: SEMPRE definir connection_limit explicitamente.
# Sem ele, o Prisma usa (num_cpus * 2 + 1) por instância — ao escalar
# horizontalmente, N instâncias esgotam o max_connections do Postgres (100).
# Regra: connection_limit * instâncias < max_connections - margem. Com mais
# de ~3 instâncias, colocar PgBouncer (modo transaction) na frente.
# pool_timeout: segundos aguardando conexão livre antes de falhar (P2024).
# Valores abaixo são para rodar a API FORA de container (localhost), contra
# o Postgres/Redis do docker-compose.yml expostos nas portas do host.
DATABASE_URL="postgresql://alegra:alegra_secret@localhost:5432/alegra_festas?schema=public&connection_limit=10&pool_timeout=20"

# Redis
REDIS_URL="redis://localhost:6379"

# Dentro da rede do docker-compose (serviço `api`), os outros serviços são
# alcançados pelo NOME do serviço, não por localhost — o docker-compose.yml
# já sobrescreve DATABASE_URL/REDIS_URL para o serviço `api` com os valores
# abaixo; isso aqui é só documentação caso precise rodar manualmente:
# DATABASE_URL="postgresql://alegra:alegra_secret@postgres:5432/alegra_festas?schema=public&connection_limit=10&pool_timeout=20"
# REDIS_URL="redis://redis:6379"

# JWT - gere com: openssl rand -base64 48  (SECRET e REFRESH devem ser DIFERENTES)
JWT_SECRET="change-me-to-a-strong-random-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-to-another-strong-random-secret-min-32-chars"
JWT_EXPIRES_IN="15m"
REFRESH_EXPIRES_IN="7d"

# Server
PORT=3333
NODE_ENV="development"

# CORS - em produção use https e o(s) domínio(s) reais, separados por vírgula.
# Ex.: https://www.alegrafestas.com.br,https://alegrafestas.com.br
CORS_ORIGIN="http://localhost:5173"

# Hops de proxy reverso confiáveis IMEDIATAMENTE na frente da API (Fastify
# `trustProxy`) - controla de onde `request.ip` é lido em X-Forwarded-For
# para rate limiting/auditoria. NUNCA superestime: cada hop a mais permite
# ao cliente forjar o IP visto pela API.
#   1 = topologia padrão do docker-compose.yml raiz (só o nginx do serviço
#       `web` entre o cliente e a API). Use este valor sem HTTPS na frente
#       (compose sozinho, sem Caddy).
#   2 = docker-compose.prod.yml (Caddy fazendo TLS na frente do nginx) ou
#       qualquer outro proxy adicional (Cloudflare/ALB) + nginx.
TRUST_PROXY_HOPS=1

# Bcrypt
BCRYPT_ROUNDS=12

# Stripe - use sk_live_/whsec_ reais em produção (sk_test_ apenas em teste).
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key_here"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_signing_secret_here"

# SMTP (Email) - OBRIGATÓRIO em produção (redefinição de senha depende disto).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Alegra Festas <noreply@alegrafestas.com.br>"

# Upload de imagens - URL base pública para servir os assets.
# Se não definida, usa o protocolo/hostname da requisição (ex.: http://localhost:3333).
# Em produção, defina com o domínio público: https://api.seudominio.com
# PUBLIC_ASSET_BASE_URL=https://api.seudominio.com

# URL pública do SITE (frontend) - usada para montar links absolutos em
# conteúdo gerado pelo backend: GET /sitemap.xml e o e-mail de lembrete de
# avaliação pós-entrega (link para /meus-pedidos). Em produção, aponte para
# o domínio público real (o boot aborta se detectar localhost/127.0.0.1 aqui
# com NODE_ENV=production).
PUBLIC_SITE_URL="http://localhost"

# Frete grátis progressivo (ver shipping-controller.ts), valores em REAIS.
# Se o subtotal do carrinho atingir o limiar da zona de destino, a opção de
# frete mais barata (exceto retirada na loja) fica grátis.
# Zona "local" = Manaus/AM (CEP 69000-000 a 69099-999); "national" = demais.
FREE_SHIPPING_THRESHOLD_LOCAL=150
FREE_SHIPPING_THRESHOLD_NATIONAL=400
