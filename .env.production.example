# =============================================================================
# Alegra Festas - Backend env (PRODUÇÃO / piloto)
#
# Cópia orientada a produção de .env.example — copie para `alegra_backend/.env`
# no servidor e preencha. Com NODE_ENV=production o boot ABORTA se detectar
# valores de exemplo, CORS/PUBLIC_SITE_URL em localhost/http, ou Stripe/SMTP
# ausentes (ver src/infra/config/env.ts, assertProductionSafety). Isso é
# intencional: preferimos falhar no boot a subir com segredo fraco.
#
# Ver deploy/DEPLOY.md para o passo a passo completo de deploy.
# =============================================================================

# --- Database / Redis ------------------------------------------------------
# O compose raiz (deploy/docker-compose.root.yml, serviço `api`) SOBRESCREVE
# DATABASE_URL/REDIS_URL para apontar aos serviços internos `postgres`/`redis`
# da rede Docker — os valores abaixo não são usados quando a API roda via
# compose, mas o Prisma exige a env var presente/válida para o schema Zod
# não falhar. Deixe como está (ou ajuste connection_limit se mudar recursos).
DATABASE_URL="postgresql://alegra:alegra_secret@postgres:5432/alegra_festas?schema=public&connection_limit=10&pool_timeout=20"
REDIS_URL="redis://redis:6379"

# --- JWT ---------------------------------------------------------------
# Gere dois segredos DIFERENTES e aleatórios:
#   openssl rand -base64 48
JWT_SECRET="COLE_AQUI_O_RESULTADO_DE_openssl_rand_-base64_48"
JWT_REFRESH_SECRET="COLE_AQUI_OUTRO_RESULTADO_DIFERENTE_DE_openssl_rand_-base64_48"
JWT_EXPIRES_IN="15m"
REFRESH_EXPIRES_IN="7d"

# --- Server --------------------------------------------------------------
PORT=3333
NODE_ENV="production"

# --- CORS / Site público ---------------------------------------------------
# Same-origin via nginx: front e API respondem no mesmo domínio, então isto
# raramente entra em jogo para chamadas do próprio front — mas continua
# sendo a origem usada para montar links absolutos (e-mails, sitemap) e o
# valor exigido pelas validações de produção. Troque SITE_DOMAIN pelo seu
# domínio real (ou pelo host sslip.io, ex.: alegra.1-2-3-4.sslip.io).
CORS_ORIGIN="https://SITE_DOMAIN"
PUBLIC_SITE_URL="https://SITE_DOMAIN"

# 2 hops: Caddy (TLS) -> nginx (web) -> api. Ver docker-compose.prod.yml,
# que já sobrescreve esta variável para "2" no serviço `api` — mantenha
# aqui também por clareza/redundância caso rode a API fora do override.
TRUST_PROXY_HOPS=2

# --- Bcrypt ------------------------------------------------------------
BCRYPT_ROUNDS=12

# --- Stripe --------------------------------------------------------------
# PILOTO: use as chaves de TESTE (sk_test_/whsec_ de teste) — cartão de
# teste 4242 4242 4242 4242, qualquer CVV/validade futura. Troque para
# sk_live_/whsec_ live somente quando o piloto virar produção real.
# Dashboard Stripe > Developers > API keys (sk_test_...) e > Webhooks
# (crie o endpoint abaixo para obter o whsec_...):
#   Endpoint: https://SITE_DOMAIN/v1/payments/webhook
#   Eventos:  payment_intent.succeeded, payment_intent.payment_failed,
#             payment_intent.canceled, charge.refunded,
#             charge.dispute.created, charge.dispute.closed
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- SMTP (Email) ----------------------------------------------------------
# OBRIGATÓRIO em produção — o boot ABORTA sem SMTP_USER/SMTP_PASS
# (assertProductionSafety em env.ts). Isso é deliberado: preferimos não
# subir a nunca poder enviar recuperação de senha. Depois do boot, porém,
# TODO envio de e-mail é best-effort a nível de request (recuperação de
# senha, formulário de contato, confirmação/envio de pedido, lembrete de
# review): uma falha pontual de SMTP (credencial errada, timeout,
# provedor fora do ar) é logada com logger.warn e NUNCA derruba a
# request com 500 — ver password-reset-controller.ts, contact-controller.ts,
# payment-controller.ts e admin-order-controller.ts.
#
# Opção 1 - Brevo (ex-Sendinblue), plano grátis cobre o volume de um
# piloto: SMTP_USER = seu login Brevo, SMTP_PASS = SMTP key (não é a senha
# da conta), SMTP_HOST="smtp-relay.brevo.com", SMTP_PORT=587.
# Opção 2 - Gmail com "senha de app" (necessita 2FA ativado na conta):
# SMTP_HOST="smtp.gmail.com", SMTP_PORT=587, SMTP_USER=seu@gmail.com,
# SMTP_PASS=senha de app de 16 caracteres (não a senha normal da conta).
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587
SMTP_USER="preencher"
SMTP_PASS="preencher"
SMTP_FROM="Alegra Festas <noreply@SITE_DOMAIN>"

# --- Upload de imagens -------------------------------------------------
# Deixe comentado: sem valor, a API usa protocolo/hostname da própria
# request (correto atrás do nginx/Caddy same-origin).
# PUBLIC_ASSET_BASE_URL=https://SITE_DOMAIN

# --- Frete grátis progressivo (ver shipping-controller.ts), em REAIS -------
FREE_SHIPPING_THRESHOLD_LOCAL=150
FREE_SHIPPING_THRESHOLD_NATIONAL=400

# =============================================================================
# PILOT_* — usadas apenas por `yarn seed:pilot` (prisma/seed-pilot.ts),
# rodado uma vez no deploy (ver deploy/DEPLOY.md, passo 5). Cria só duas
# contas (admin + 1 cliente de teste com endereço em Manaus) — nenhum
# produto/pedido/review. Senhas com no mínimo 12 caracteres; gere com:
#   openssl rand -base64 18
# =============================================================================
PILOT_ADMIN_EMAIL="admin@SITE_DOMAIN"
PILOT_ADMIN_PASSWORD="preencher-min-12-chars"
PILOT_USER_EMAIL="cliente.teste@SITE_DOMAIN"
PILOT_USER_PASSWORD="preencher-min-12-chars"
# true para permitir que uma nova execução de `yarn seed:pilot` sobrescreva
# a senha de uma conta PILOT_* já existente (ex.: rotação de credencial).
# Deixe "false"/ausente no dia a dia — o script nunca troca senha sem isto.
PILOT_RESET_PASSWORDS=false
